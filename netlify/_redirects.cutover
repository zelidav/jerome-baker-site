# ---- pattern rules: keep last, in this order ----
/blogs/news/tagged/*  /story/  301
/account/*  https://shop.jeromebaker.com/account/:splat  301
# Must go to Shopify: the new site's 84 studio-store Buy buttons use these cart links
/cart/*  https://shop.jeromebaker.com/cart/:splat  301
# Keeps old image URLs (Google Images, old articles) working
/cdn/*  https://shop.jeromebaker.com/cdn/:splat  301
# Checkout stays on Shopify
/checkouts/*  https://shop.jeromebaker.com/checkouts/:splat  301
# 1998-2007 site, 31 pages
/gallery/people/*  /story/  301
# 1998-2007 site, 200+ pages
/gallery/*  /glass/  301
# 1998-2007 site, 45 pages
/lounge/*  /story/  301
# 1998-2007 site
/about/*  /story/  301
# 1998-2007 site
/studio/*  /story/  301
# 1998-2007 site
/orders/*  /  301
# 1998-2007 site
/newsite/*  /  301
# 2016-17 WordPress, 29 tag pages
/product-tag/*  /glass/  301
# Catch-all after the exact /product/ rows
/product/*  /glass/  301
# Catch-all after the exact /p/ rows
/p/*  /glass/  301
# Catch-all
/bakercasts-blogs/*  /story/  301
# 2016 WordPress
/category/*  /story/  301
# 2016 WordPress
/author/*  /story/  301
# 2016 WordPress pagination
/shop/page/*  /shop/  301
# 2016 WordPress
/locations/*  /wholesale/  301
# 2016 WordPress
/wholesale/page/*  /wholesale/  301
# 2016 WordPress
/wishlist/*  /glass/  301
# 2016 WordPress
/my-account/*  https://shop.jeromebaker.com/account  301
# 2019 BakerCast posts
/posts/*  /story/  301
# Shopify collection-scoped product URLs, 2 hops
/collections/:collection/products/:handle  /products/:handle  301
# Last-resort catch-all for any product URL not listed above
/products/*  /glass/  302
# Last-resort catch-all
/collections/*  /glass/  302
